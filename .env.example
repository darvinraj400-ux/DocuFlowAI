# ---------------------------------------------------------------------------
# DocuFlow AI — environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit real secrets. Never put service-role keys or API keys in
# NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (browser-safe) key. The legacy anon key is also accepted as a
# fallback (NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key. SERVER ONLY — used by server-side admin client, never sent
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical origin used to build confirmation/reset email links
# (e.g. https://your-app.vercel.app). If unset, the origin is derived from
# request headers with a localhost fallback in development.
NEXT_PUBLIC_SITE_URL=

# --- AI extraction provider (Phase 2) ---
# "gemini" (default), "groq", or "mock" (explicit demo mode, no API key
# required). Mock mode is visibly labelled in the UI and is never an invisible
# production fallback.
AI_PROVIDER=gemini

# Gemini API key. SERVER ONLY — never expose to the browser. Required only
# when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Configurable Gemini model id.
GEMINI_MODEL=gemini-3.8-flash

# Groq API key. SERVER ONLY — never expose to the browser. Required only when
# AI_PROVIDER=groq.
GROQ_API_KEY=

# Configurable Groq model id. Default is qwen/qwen3.8-27b, Groq's multimodal
# model (text + up to 3 images per request), so both digitally generated PDFs
# and scanned/image-only PDFs can be extracted. To use a text-only Groq model
# instead (e.g. openai/gpt-oss-20b), note that image-based inputs will be
# rejected with a clear error — or use AI_PROVIDER=gemini for those.
GROQ_MODEL=qwen/qwen3.8-27b

# Max pages accepted for PDF uploads (default 10).
MAX_PDF_PAGES=10

# Max invoices processing concurrently per user (default 3). Also used as the
# Inngest per-user concurrency limit for the process-invoice function.
MAX_CONCURRENT_PROCESSING=3

# --- Inngest durable processing (SERVER ONLY) ---
# Local development: leave these empty and run the Inngest Dev Server. The app
# uses dev mode automatically outside production; set INNGEST_DEV=1 to force it
# (or INNGEST_DEV=0 to force cloud mode).
INNGEST_DEV=

# Inngest Cloud only. Create these in the Inngest dashboard. NEVER expose them
# to the browser and never prefix them with NEXT_PUBLIC_.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Opt-in LIVE tests (never used by the app; for integration/eval harnesses) ---
# RUN_LIVE_INTEGRATION_TESTS=false
# RUN_LIVE_GEMINI_TESTS=false

# --- n8n webhook (optional, Phase 5) ---
N8N_WEBHOOK_URL=
